# Root
.DS_Store

# Env (compose-level secrets)
/.env

# Laravel (system/)
/system/vendor
/system/node_modules
/system/.env
/system/storage/*.key
/system/storage/logs/*.log
/system/storage/framework/cache/*
/system/storage/framework/sessions/*
/system/storage/framework/views/*
/system/public/docs
/system/public/storage
/system/.phpunit.result.cache

# Next.js (web/)
/web/node_modules
/web/.next
/web/out
/web/.env*.local
