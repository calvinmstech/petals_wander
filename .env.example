# ── Host ports (localhost:8014 onwards) ─────────────────────────────────────
SYSTEM_PORT=8014   # Laravel API
WEB_PORT=8015      # Next.js storefront + admin
DB_PORT=8016       # PostgreSQL
ADMINER_PORT=8017  # Adminer DB UI
MAILPIT_UI_PORT=8025 # Mailpit web UI (catches outgoing email in dev)

# ── PostgreSQL credentials ──────────────────────────────────────────────────
POSTGRES_DB=flowershop
POSTGRES_USER=flowershop
POSTGRES_PASSWORD=secret

# ── Integrations ────────────────────────────────────────────────────────────
# Optional. Enables live Grab/Lalamove distance pricing at checkout via the
# Google Distance Matrix API. Leave empty to use the admin fallback distance.
GOOGLE_MAPS_API_KEY=
