# ── Production environment ───────────────────────────────────────────────────
# Copy to `.env` on the server and fill in. Never commit the real `.env`.
#   cp .env.production.example .env

# ── App identity ─────────────────────────────────────────────────────────────
APP_NAME="Petals Wander"

# APP_URL must be exactly how a browser reaches the site — it is baked into the
# URLs of uploaded images/receipts. On the FIRST (HTTP-only) deploy use the raw
# static IP; once DNS is live switch both APP_URL and SITE_ADDRESS to the domain.
#   First deploy (HTTP):  APP_URL=http://YOUR.STATIC.IP    APP_DOMAIN=YOUR.STATIC.IP   SITE_ADDRESS=:80
#   With domain (HTTPS):  APP_URL=https://petalswander.com  APP_DOMAIN=petalswander.com SITE_ADDRESS=petalswander.com
APP_URL=http://YOUR.STATIC.IP
APP_DOMAIN=YOUR.STATIC.IP
SITE_ADDRESS=:80

APP_TIMEZONE=Asia/Kuala_Lumpur

# Generate once and paste the result here (see DEPLOY.md):
#   docker compose -f docker-compose.prod.yml run --rm system php artisan key:generate --show
APP_KEY=

# ── PostgreSQL (internal only — not published) ───────────────────────────────
POSTGRES_DB=flowershop
POSTGRES_USER=flowershop
# Use a strong, unique password:  openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME

# ── Email ────────────────────────────────────────────────────────────────────
# Log-only for now: order emails are written to storage/logs instead of sent.
# To enable real email later, set MAIL_MAILER=smtp and fill the rest.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=hello@petalwanders.test

# ── Optional integrations ────────────────────────────────────────────────────
# Live Grab/Lalamove distance pricing. Empty = admin fallback distance is used.
GOOGLE_MAPS_API_KEY=
# Protects the /docs API reference if you choose to expose it.
SCRIBE_AUTH_KEY=
